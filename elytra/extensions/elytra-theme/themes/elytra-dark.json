{
	"$schema": "vscode://schemas/color-theme",
	"name": "Elytra Dark",
	"type": "dark",
	"semanticHighlighting": true,
	"colors": {
		"foreground": "#cccccc",
		"focusBorder": "#007acc",
		"widget.border": "#3c3c3c",
		"widget.shadow": "#00000080",
		"selection.background": "#264f78",
		"descriptionForeground": "#9d9d9d",
		"errorForeground": "#f14c4c",
		"icon.foreground": "#cccccc",
		"editor.background": "#1e1e1e",
		"editor.foreground": "#d4d4d4",
		"editorLineNumber.foreground": "#6e7681",
		"editorLineNumber.activeForeground": "#cccccc",
		"editorCursor.foreground": "#aeafad",
		"editor.selectionBackground": "#264f78",
		"editor.inactiveSelectionBackground": "#3a3d41",
		"editor.lineHighlightBackground": "#2a2d2e",
		"editor.lineHighlightBorder": "#282828",
		"editorWhitespace.foreground": "#3b3b3b",
		"editorIndentGuide.background1": "#404040",
		"editorIndentGuide.activeBackground1": "#707070",
		"editorBracketMatch.background": "#0d3a58",
		"editorBracketMatch.border": "#888888",
		"editorGutter.background": "#1e1e1e",
		"editorGutter.modifiedBackground": "#007acc",
		"editorGutter.addedBackground": "#487e02",
		"editorGutter.deletedBackground": "#f14c4c",
		"editorError.foreground": "#f14c4c",
		"editorWarning.foreground": "#cca700",
		"editorInfo.foreground": "#3794ff",
		"editorHint.foreground": "#eeeeeeb3",
		"editorGroupHeader.tabsBackground": "#2d2d2d",
		"editorGroupHeader.tabsBorder": "#252526",
		"editorGroup.border": "#3c3c3c",
		"tab.activeBackground": "#1e1e1e",
		"tab.inactiveBackground": "#2d2d2d",
		"tab.activeForeground": "#ffffff",
		"tab.inactiveForeground": "#858585",
		"tab.border": "#252526",
		"tab.activeBorder": "#1e1e1e",
		"tab.activeBorderTop": "#007acc",
		"tab.hoverBackground": "#2a2d2e",
		"tab.unfocusedActiveBackground": "#1e1e1e",
		"activityBar.background": "#333333",
		"activityBar.foreground": "#ffffff",
		"activityBar.inactiveForeground": "#858585",
		"activityBar.border": "#3c3c3c",
		"activityBarBadge.background": "#007acc",
		"activityBarBadge.foreground": "#ffffff",
		"activityBar.activeBorder": "#ffffff",
		"activityBar.activeBackground": "#2a2d2e",
		"sideBar.background": "#252526",
		"sideBar.foreground": "#cccccc",
		"sideBar.border": "#3c3c3c",
		"sideBarTitle.foreground": "#bbbbbb",
		"sideBarSectionHeader.background": "#252526",
		"sideBarSectionHeader.foreground": "#cccccc",
		"sideBarSectionHeader.border": "#3c3c3c",
		"list.activeSelectionBackground": "#37373d",
		"list.activeSelectionForeground": "#ffffff",
		"list.inactiveSelectionBackground": "#37373d",
		"list.hoverBackground": "#2a2d2e",
		"list.focusBackground": "#062f4a",
		"list.highlightForeground": "#2aaaff",
		"tree.indentGuidesStroke": "#585858",
		"statusBar.background": "#007acc",
		"statusBar.foreground": "#ffffff",
		"statusBar.border": "#007acc",
		"statusBar.noFolderBackground": "#68217a",
		"statusBar.debuggingBackground": "#cc6633",
		"statusBarItem.hoverBackground": "#ffffff1f",
		"statusBarItem.remoteBackground": "#16825d",
		"statusBarItem.remoteForeground": "#ffffff",
		"titleBar.activeBackground": "#252526",
		"titleBar.activeForeground": "#cccccc",
		"titleBar.inactiveBackground": "#252526",
		"titleBar.inactiveForeground": "#858585",
		"titleBar.border": "#3c3c3c",
		"panel.background": "#1e1e1e",
		"panel.border": "#3c3c3c",
		"panelTitle.activeForeground": "#cccccc",
		"panelTitle.inactiveForeground": "#858585",
		"panelTitle.activeBorder": "#007acc",
		"terminal.background": "#1e1e1e",
		"terminal.foreground": "#cccccc",
		"terminalCursor.foreground": "#ffffff",
		"button.background": "#007acc",
		"button.foreground": "#ffffff",
		"button.hoverBackground": "#026ec1",
		"button.secondaryBackground": "#3a3d41",
		"button.secondaryForeground": "#cccccc",
		"input.background": "#3c3c3c",
		"input.foreground": "#cccccc",
		"input.border": "#3c3c3c",
		"inputOption.activeBackground": "#007acc",
		"dropdown.background": "#3c3c3c",
		"dropdown.foreground": "#cccccc",
		"dropdown.border": "#3c3c3c",
		"checkbox.background": "#3c3c3c",
		"checkbox.foreground": "#cccccc",
		"checkbox.border": "#3c3c3c",
		"notifications.background": "#252526",
		"notifications.foreground": "#cccccc",
		"notifications.border": "#3c3c3c",
		"editorWidget.background": "#252526",
		"editorWidget.border": "#3c3c3c",
		"editorSuggestWidget.background": "#252526",
		"editorSuggestWidget.border": "#3c3c3c",
		"editorSuggestWidget.selectedBackground": "#04395e",
		"editorHoverWidget.background": "#252526",
		"editorHoverWidget.border": "#3c3c3c",
		"quickInput.background": "#252526",
		"quickInput.foreground": "#cccccc",
		"gitDecoration.modifiedResourceForeground": "#e2c08d",
		"gitDecoration.deletedResourceForeground": "#c74e39",
		"gitDecoration.untrackedResourceForeground": "#73c991",
		"gitDecoration.ignoredResourceForeground": "#8c8c8c",
		"diffEditor.insertedTextBackground": "#9bb95533",
		"diffEditor.removedTextBackground": "#ff000033",
		"scrollbar.shadow": "#000000",
		"scrollbarSlider.background": "#79797966",
		"scrollbarSlider.hoverBackground": "#646464b3",
		"scrollbarSlider.activeBackground": "#bfbfbf66",
		"contrastBorder": "#00000000",
		"editorGroup.dropBackground": "#53595d80"
	},
	"tokenColors": [
		{ "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6A9955", "fontStyle": "italic" } },
		{ "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "#C586C0" } },
		{ "scope": ["string", "string.quoted", "constant.other.symbol"], "settings": { "foreground": "#CE9178" } },
		{ "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#B5CEA8" } },
		{ "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#DCDCAA" } },
		{ "scope": ["entity.name.type", "support.type", "support.class", "entity.name.class"], "settings": { "foreground": "#4EC9B0" } },
		{ "scope": ["variable", "variable.other", "variable.parameter"], "settings": { "foreground": "#9CDCFE" } },
		{ "scope": ["variable.other.property", "meta.object-literal.key"], "settings": { "foreground": "#9CDCFE" } },
		{ "scope": ["entity.name.tag", "punctuation.definition.tag"], "settings": { "foreground": "#569CD6" } },
		{ "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#9CDCFE" } },
		{ "scope": ["constant.character.escape"], "settings": { "foreground": "#D7BA7D" } },
		{ "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#F44747" } }
	]
}

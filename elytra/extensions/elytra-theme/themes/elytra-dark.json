{
	"$schema": "vscode://schemas/color-theme",
	"name": "Elytra Dark",
	"type": "dark",
	"semanticHighlighting": true,
	"colors": {
		"foreground": "#e2e8f0",
		"focusBorder": "#3b82f6",
		"widget.border": "#26262e",
		"widget.shadow": "#000000a0",
		"selection.background": "#3b82f640",
		"descriptionForeground": "#94a3b8",
		"errorForeground": "#ef4444",
		"icon.foreground": "#cbd5e1",
		"editor.background": "#121214",
		"editor.foreground": "#f1f5f9",
		"editorLineNumber.foreground": "#475569",
		"editorLineNumber.activeForeground": "#94a3b8",
		"editorCursor.foreground": "#3b82f6",
		"editor.selectionBackground": "#3b82f638",
		"editor.inactiveSelectionBackground": "#282d3d",
		"editor.lineHighlightBackground": "#18181c",
		"editor.lineHighlightBorder": "#18181c00",
		"editorWhitespace.foreground": "#282830",
		"editorIndentGuide.background1": "#23232a",
		"editorIndentGuide.activeBackground1": "#475569",
		"editorBracketMatch.background": "#3b82f625",
		"editorBracketMatch.border": "#3b82f680",
		"editorGutter.background": "#121214",
		"editorGutter.modifiedBackground": "#3b82f6",
		"editorGutter.addedBackground": "#22c55e",
		"editorGutter.deletedBackground": "#ef4444",
		"editorError.foreground": "#ef4444",
		"editorWarning.foreground": "#f59e0b",
		"editorInfo.foreground": "#3b82f6",
		"editorHint.foreground": "#94a3b8",
		"editorGroupHeader.tabsBackground": "#141416",
		"editorGroupHeader.tabsBorder": "#1e1e24",
		"editorGroup.border": "#1e1e24",
		"tab.activeBackground": "#121214",
		"tab.inactiveBackground": "#141416",
		"tab.activeForeground": "#f8fafc",
		"tab.inactiveForeground": "#64748b",
		"tab.border": "#1e1e24",
		"tab.activeBorder": "#121214",
		"tab.activeBorderTop": "#3b82f6",
		"tab.hoverBackground": "#18181c",
		"tab.unfocusedActiveBackground": "#121214",
		"activityBar.background": "#0e0e10",
		"activityBar.foreground": "#f8fafc",
		"activityBar.inactiveForeground": "#64748b",
		"activityBar.border": "#1e1e24",
		"activityBarBadge.background": "#3b82f6",
		"activityBarBadge.foreground": "#ffffff",
		"activityBar.activeBorder": "#3b82f6",
		"activityBar.activeBackground": "#18181c",
		"sideBar.background": "#141416",
		"sideBar.foreground": "#cbd5e1",
		"sideBar.border": "#1e1e24",
		"sideBarTitle.foreground": "#f1f5f9",
		"sideBarSectionHeader.background": "#141416",
		"sideBarSectionHeader.foreground": "#94a3b8",
		"sideBarSectionHeader.border": "#1e1e24",
		"list.activeSelectionBackground": "#222530",
		"list.activeSelectionForeground": "#f8fafc",
		"list.inactiveSelectionBackground": "#1a1a20",
		"list.hoverBackground": "#18181c",
		"list.focusBackground": "#222530",
		"list.highlightForeground": "#60a5fa",
		"tree.indentGuidesStroke": "#282832",
		"statusBar.background": "#0e0e10",
		"statusBar.foreground": "#94a3b8",
		"statusBar.border": "#1e1e24",
		"statusBar.noFolderBackground": "#0e0e10",
		"statusBar.debuggingBackground": "#854d0e",
		"statusBarItem.hoverBackground": "#1e1e24",
		"statusBarItem.remoteBackground": "#2563eb",
		"statusBarItem.remoteForeground": "#ffffff",
		"titleBar.activeBackground": "#0e0e10",
		"titleBar.activeForeground": "#cbd5e1",
		"titleBar.inactiveBackground": "#0e0e10",
		"titleBar.inactiveForeground": "#64748b",
		"titleBar.border": "#1e1e24",
		"panel.background": "#121214",
		"panel.border": "#1e1e24",
		"panelTitle.activeForeground": "#f8fafc",
		"panelTitle.inactiveForeground": "#64748b",
		"panelTitle.activeBorder": "#3b82f6",
		"terminal.background": "#121214",
		"terminal.foreground": "#f1f5f9",
		"terminalCursor.foreground": "#3b82f6",
		"button.background": "#3b82f6",
		"button.foreground": "#ffffff",
		"button.hoverBackground": "#2563eb",
		"button.secondaryBackground": "#222228",
		"button.secondaryForeground": "#cbd5e1",
		"input.background": "#18181c",
		"input.foreground": "#f1f5f9",
		"input.border": "#282832",
		"inputOption.activeBackground": "#3b82f6",
		"dropdown.background": "#18181c",
		"dropdown.foreground": "#f1f5f9",
		"dropdown.border": "#282832",
		"checkbox.background": "#18181c",
		"checkbox.foreground": "#f1f5f9",
		"checkbox.border": "#282832",
		"notifications.background": "#18181c",
		"notifications.foreground": "#f1f5f9",
		"notifications.border": "#282832",
		"editorWidget.background": "#18181c",
		"editorWidget.border": "#282832",
		"editorSuggestWidget.background": "#18181c",
		"editorSuggestWidget.border": "#282832",
		"editorSuggestWidget.selectedBackground": "#222530",
		"editorHoverWidget.background": "#18181c",
		"editorHoverWidget.border": "#282832",
		"quickInput.background": "#18181c",
		"quickInput.foreground": "#f1f5f9",
		"gitDecoration.modifiedResourceForeground": "#60a5fa",
		"gitDecoration.deletedResourceForeground": "#ef4444",
		"gitDecoration.untrackedResourceForeground": "#4ade80",
		"gitDecoration.ignoredResourceForeground": "#64748b",
		"diffEditor.insertedTextBackground": "#22c55e20",
		"diffEditor.removedTextBackground": "#ef444420",
		"scrollbar.shadow": "#00000080",
		"scrollbarSlider.background": "#47556930",
		"scrollbarSlider.hoverBackground": "#47556960",
		"scrollbarSlider.activeBackground": "#47556990",
		"contrastBorder": "#00000000",
		"editorGroup.dropBackground": "#3b82f620"
	},
	"tokenColors": [
		{ "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#64748b", "fontStyle": "italic" } },
		{ "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "#c084fc" } },
		{ "scope": ["string", "string.quoted", "constant.other.symbol"], "settings": { "foreground": "#fb923c" } },
		{ "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#a3e635" } },
		{ "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#60a5fa" } },
		{ "scope": ["entity.name.type", "support.type", "support.class", "entity.name.class"], "settings": { "foreground": "#38bdf8" } },
		{ "scope": ["variable", "variable.other", "variable.parameter"], "settings": { "foreground": "#f1f5f9" } },
		{ "scope": ["variable.other.property", "meta.object-literal.key"], "settings": { "foreground": "#94a3b8" } },
		{ "scope": ["entity.name.tag", "punctuation.definition.tag"], "settings": { "foreground": "#f43f5e" } },
		{ "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#fbbf24" } },
		{ "scope": ["constant.character.escape"], "settings": { "foreground": "#e879f9" } },
		{ "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#ef4444" } }
	]
}
